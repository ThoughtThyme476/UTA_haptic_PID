// Testing out the encoder & PID stabilization
#include <Encoder.h>
#define ENCODER_OPTIMIZE_INTERRUPTS

const int encA = 2;
const int encB = 3;
const int MotIn1 = 5;
const int MotIn2 = 4;
const int pwm = 9;

Encoder myEncoder(encA, encB);

// --- Settle Tolerance Configuration ---
const double settleTolerance = 3.0; // Stay off if within 5 encoder counts of target

double vKp;
double vKi;
double vKd;

double error = 0;
double prevError = 0;
double integralAcc = 0;
double power = 0;


int choose = 1;


void setConstants(double kp, double ki, double kd) {
    vKp = kp;
    vKi = ki;
    vKd = kd;
}

double calcPID(double target, double input, double integralKi, double maxIntegral) {
    prevError = error;
    error = target - input;

    // Settle tolerance check: turn off power and clear integral if within range
    if (abs(error) <= settleTolerance) {
        integralAcc = 0;
        return 0.0;
    }

    // Integral calculation
    if (abs(error) < integralKi) {
        integralAcc += error;
    } else {
        integralAcc = 0; // Reset integral if outside threshold
    }
   
    // Clamp integral
    integralAcc = constrain(integralAcc, -maxIntegral, maxIntegral);

    // Derivative calculation
    double derivative = error - prevError;

    // Compute raw PID output
    double computedPower = (vKp * error) + (vKi * integralAcc) + (vKd * derivative);

    // Constrain to maximum PWM limits (-255 to 255)
    return constrain(computedPower, -255.0, 255.0);
}

void moveMotor(double motorPower) {
    int pwmVal = constrain((int)abs(motorPower), 0, 255);

    if (motorPower > 0) {
        // Spin Forward
        digitalWrite(MotIn1, HIGH);
        digitalWrite(MotIn2, LOW);
    } else if (motorPower < 0) {
        // Spin Backward
        digitalWrite(MotIn1, LOW);
        digitalWrite(MotIn2, HIGH);
    } else {
        // Stop
        digitalWrite(MotIn1, LOW);
        digitalWrite(MotIn2, LOW);
        pwmVal = 0;
    }

    analogWrite(pwm, pwmVal);
}

void setup() {
    Serial.begin(115200);
    pinMode(MotIn1, OUTPUT);
    pinMode(MotIn2, OUTPUT);
    pinMode(pwm, OUTPUT);
   
    // NOTE: If the motor runs away at full speed when you test it,
    // change vKp to a negative value (e.g., -0.5) to reverse the loop direction.
    // setConstants(20, 0.0, 0.0);
}

void loop() {


switch(choose){
    case 0: //spring
    {
        setConstants(4.5,0.0,0.0);
    double targetPosition = 0.0;
    double currentPosition = myEncoder.read();

    // Compute PID output
    power = calcPID(targetPosition, currentPosition, 0, 0);

    // Send the calculated power to the motor
    moveMotor(power);

    // Debugging output
    Serial.print("Target: ");
    Serial.print(targetPosition);
    Serial.print(" | Current: ");
    Serial.print(currentPosition);
    Serial.print(" | Power: ");
    Serial.println(power);

    delay(10);
        }

        case 1: //wall
        {
            setConstants(20.0,0.0,5.0);
    double targetPosition = 0.0;
    double currentPosition = myEncoder.read();

    // Compute PID output
    power = calcPID(targetPosition, currentPosition, 0, 0);

    // Send the calculated power to the motor
    moveMotor(power);

    // Debugging output
    Serial.print("Target: ");
    Serial.print(targetPosition);
    Serial.print(" | Current: ");
    Serial.print(currentPosition);
    Serial.print(" | Power: ");
    Serial.println(power);

    delay(10);

        }

         case 2: //hill
        {
            setConstants(2.0,0.0,1.0);
    double targetPosition = 0.0;
    double currentPosition = myEncoder.read();

    // Compute PID output
    power = calcPID(targetPosition, currentPosition, 0, 0);

    // Send the calculated power to the motor
    moveMotor(-power);

    // Debugging output
    Serial.print("Target: ");
    Serial.print(targetPosition);
    Serial.print(" | Current: ");
    Serial.print(currentPosition);
    Serial.print(" | Power: ");
    Serial.println(power);

    delay(10);

        }
    }
}
