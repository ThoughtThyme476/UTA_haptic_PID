void loop() {
    // 1. Define a target position (for testing, let's say 1000 encoder counts)
    double targetPosition = 0.0; 

    // 2. Read the current encoder position
    double currentPosition = myEncoder.read();

    // 3. Compute PID output (passing target, input, integral threshold, max integral)
    // Make sure to initialize your constants using setConstants() in setup() first!
    calcPID(targetPosition, currentPosition, 50, 200);

    // 4. Send the calculated power to the motor
    moveMotor(power);

    // Optional: Print to Serial Monitor for debugging
    Serial.print("Target: ");
    Serial.print(targetPosition);
    Serial.print(" | Current: ");
    Serial.print(currentPosition);
    Serial.print(" | Power: ");
    Serial.println(power);

    // Small delay to keep serial readable (though PID loops prefer consistent timing)
    delay(10); 
}
